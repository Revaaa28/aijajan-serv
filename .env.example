# AIJajan configuration — copy to .env and edit.
# With the defaults below the app runs fully in MOCK mode (no accounts needed).

# PayPal sandbox app credentials (https://developer.paypal.com -> Sandbox app).
# Leave empty (or set PAYPAL_MOCK=1) to simulate PayPal entirely.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 1 = simulate PayPal even if credentials are present.
PAYPAL_MOCK=1
# Sandbox email that receives Jaja's purchase payouts (default below is a
# placeholder; use a sandbox account email to watch funds land there).
PAYPAL_PAYOUT_RECEIVER=merchants@aijajan.example

# Google Gemini API key (optional, voices the diary). Empty = built-in templates.
GEMINI_API_KEY=

# OpenServ SERV Reasoning API key (SERV edition).
# Leave empty (or set SERV_MOCK=1) to use the built-in deterministic
# reasoning engine — full reasoning traces, zero network calls.
SERV_API_KEY=
# 1 = simulate SERV Reasoning even if a key is present.
SERV_MOCK=1
# Optional: override the SERV Reasoning API base URL.
SERV_API_URL=
# Optional: which SERV model plans missions (default google/gemini-2.5-flash).
SERV_MODEL=
# Optional: per-call timeout in ms before the built-in planner takes over
# (default 45000).
SERV_TIMEOUT_MS=

# Port for the web server.
PORT=3000
